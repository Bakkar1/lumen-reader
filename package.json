{
  "name": "lumen-reader",
  "description": "Reads web pages aloud with sentence and word highlighting.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "cross-env LUMEN_FAKE_TTS=1 wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:e2e && playwright test",
    "postinstall": "wxt prepare && node scripts/fetch-kokoro.mjs",
    "kokoro": "node scripts/fetch-kokoro.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "cross-env": "^10.1.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
